{
  "name": "@trycompai/mcp-server",
  "version": "0.2.5",
  "author": "Comp AI",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/trycompai/comp.git",
    "directory": "apps/mcp-server"
  },
  "bin": {
    "@trycompai/mcp-server": "bin/mcp-server.js",
    "mcp": "bin/mcp-server.js"
  },
  "scripts": {
    "build": "bun i && bun src/mcp-server/build.mts && tsc",
    "mcpb:build": "bun i && bun src/mcp-server/build.mts --pack && tsc",
    "check": "npm run lint",
    "lint": "eslint --cache --max-warnings=0 src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@stricli/core": "^1.3.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "hono": ">=4.12.25",
    "fast-uri": ">=4.2.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.5",
    "bun": "^1.4.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
