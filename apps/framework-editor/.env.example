# The NestJS API this app reads and writes through. Every page loads its data
# via app/lib/api-client.ts / api-server.ts, so nothing renders without it.
#
# NEXT_PUBLIC_* values are inlined at build time, so this must be set when
# `next build` runs — in Docker pass it as a build arg (see Dockerfile), not
# only as a runtime variable, or the bundle keeps the localhost fallback.
NEXT_PUBLIC_API_URL=http://localhost:3333

# Optional. Server-side-only override for the session proxy in app/lib/auth.ts,
# for when server components should reach the API on a private address. Falls
# back to NEXT_PUBLIC_API_URL.
# BACKEND_API_URL=http://api.internal:3333

# Optional. Only read by prisma.config.ts and prisma/client.ts. `prisma generate`
# never connects, and no code under app/ touches the database, so a placeholder
# is enough — a well-formed URL keeps `prisma migrate`/`studio` failing loudly
# instead of reaching a real database by accident.
# DATABASE_URL="postgresql://user:pass@localhost:5432/placeholder"

# The app itself listens on 3004 in dev (`next dev --port 3004`). In the Docker
# image the standalone server honours $PORT and defaults to 3000; set PORT to
# match your platform's target port if it pins one.
# PORT=8080
