    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/archiver": "^8.0.0",
        "@types/node": "^24.19.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.2",
        "jsdom": "^26.1.0",
        "postcss": "^8.5.31",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "peerDependencies": {
        "react": "^19.1.1",
        "react-dom": "^19.1.0"
    },
    "private": true,
    "scripts": {
        "build": "next build",
        "build:docker": "prisma generate --schema=prisma/schema && node ../../packages/db/scripts/fix-generated-extensions.js src/generated/prisma && next build",
        "db:generate": "bun run db:getschema && prisma generate --schema=prisma/schema && node ../../packages/db/scripts/fix-generated-extensions.js src/generated/prisma",
        "db:getschema": "find prisma/schema -name '*.prisma' ! -name 'schema.prisma' -delete && find ../../packages/db/prisma/schema -name '*.prisma' ! -name 'schema.prisma' -exec cp {} prisma/schema/ \\;",
        "db:migrate": "cd ../../packages/db && bunx prisma migrate dev && cd ../../apps/portal",
        "dev": "next dev --turbopack -p 3002",
        "lint": "eslint . && prettier --check .",
        "prebuild": "bun run db:generate",
        "start": "next start",
        "test": "vitest run"
    }
}
