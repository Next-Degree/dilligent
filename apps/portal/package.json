    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/archiver": "^6.0.4",
        "@types/node": "^24.19.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "15.5.27",
        "jsdom": "^26.1.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
