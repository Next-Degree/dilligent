# A custom .semgrepignore replaces Semgrep's built-in defaults, so they are
# restated here. .gitignore'd paths are already skipped.

# Version control
.git
.svn
_darcs

# Build output and dependencies
build/
vendor/
dist/
*.min.js
.env/
.tox/
node_modules/
.npm/
.yarn/
.venv/
_opam/
_build/
_cargo/

# Test paths
test/
tests/
testsuite/
*_test.go

# Disabled workflows never run
.github/workflows_disabled/
