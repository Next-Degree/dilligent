{
  "name": "@trycompai/email",
  "description": "Email templates and utilities for Comp AI",
  "version": "1.0.0",
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@react-email/tailwind": "2.0.7",
    "@trycompai/utils": "workspace:*",
    "date-fns": "^4.1.0",
    "react-email": "^6.11.3",
    "resend": "^6.34.1",
    "responsive-react-email": "^0.0.5"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./emails/*": "./emails/*",
    "./lib/*": "./lib/*"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "keywords": [
    "comp-ai",
    "email-templates",
    "react-email"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-ai/comp.git",
    "directory": "packages/email"
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts",
    "clean": "rm -rf .turbo node_modules dist",
    "dev": "tsup index.ts --format cjs,esm --watch --dts",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "types": "./dist/index.d.ts"
}
