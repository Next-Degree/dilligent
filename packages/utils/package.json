{
  "name": "@trycompai/utils",
  "version": "1.0.0",
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./devices": {
      "types": "./src/devices.ts",
      "import": "./dist/devices.js",
      "default": "./dist/devices.js"
    },
    "./envs": {
      "types": "./src/envs.ts",
      "import": "./dist/envs.js",
      "default": "./dist/envs.js"
    },
    "./format": {
      "types": "./src/format.ts",
      "import": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./vendors": {
      "types": "./src/vendors/index.ts",
      "import": "./dist/vendors/index.js",
      "default": "./dist/vendors/index.js"
    }
  },
  "main": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "types": "./src/index.ts"
}
